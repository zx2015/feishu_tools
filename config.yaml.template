# 飞书配置
feishu:
  app_id: "cli_xxxxxxxx"       # 飞书应用的 App ID
  app_secret: "xxxxxxxxxxxx"   # 飞书应用的 App Secret
  webhook_url: ""             # 机器人 Webhook 地址 (可选)
